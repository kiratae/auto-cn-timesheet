# Copy to .env (Bun loads it automatically). Keep .env out of git.
TIMESHEET_BASE_URL=https://timesheet.clicknext.com
TIMESHEET_API_KEY=tcs_...

GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-...            # needs read_api scope
GIT_AUTHOR_EMAILS=you@company.com,you@personal.com

OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible /chat/completions
OPENAI_API_KEY=...
OPENAI_MODEL=...

LINE_DIR=line_messages             # folder with [LINE]*.txt exports, relative to this project (or absolute)
ME_NAME=kiratae                   # your LINE display name
ME_PATTERNS=kiratae,เต้(?![นา]),@All   # comma-separated regexes that count as "mentions me"
WORK_HOURS=09:00-18:00
LUNCH=12:00-13:00
TZ_OFFSET=+07:00
WFH_DEFAULT=false                 # initial WFH state for generated entries (toggle per entry in the UI)
ROLE=Developer                    # default role (task-type group); the UI dropdown overrides it

# Optional: Jev (TypeSafe System One) picks project + task type and reports confidence.
# Without JEV_API_KEY the LLM picks them from a catalog instead.
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.6            # picks below this are flagged "⚠ check" in the UI/CLI

# "Refresh from LINE" / bun run line-export: drives LINE for Windows to re-save these chats into LINE_DIR.
# Comma-separated, exactly as the chat names appear in LINE.
LINE_CHATS=OIC-IBSL_ทีมงาน,P_CH,SM.,Fern🧚🏻💚,WA CPD FCS
LINE_EXE=                         # optional; default %LOCALAPPDATA%\LINE\bin\LineLauncher.exe
